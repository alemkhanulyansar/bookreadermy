{
  "name": "fb2-reader",
  "version": "1.0.1",
  "description": "Программа для чтения книг в формате FB2",
  "main": "main.js",
  "author": "FB2 Reader",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "ru.fb2reader.app",
    "productName": "FB2 Reader",
    "directories": {
      "output": "C:\\Temp\\FB2Reader"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "alemkhanulyansar",
      "repo": "bookreadermy",
      "releaseType": "release"
    }
  }
}
